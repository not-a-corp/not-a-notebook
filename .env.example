# Copy to .env and fill the values in.

# Password for the PostgreSQL role the service uses.
POSTGRES_PASSWORD=change-me

# Signs the access tokens. At least 32 characters; generate one with:
#   docker run --rm python:3.14-slim python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Changing it voids every access token at once; clients get a new one through
# their refresh cookie, so nobody is signed out.
JWT_SECRET=

# false closes registration — except for the first account, so you can set it
# from the first boot and still create your own.
REGISTRATION_OPEN=true
