# Copy to .env and fill the values in.

# Password for the PostgreSQL role the service uses.
POSTGRES_PASSWORD=change-me

# Signs the access tokens. At least 32 characters; generate one with:
#   docker run --rm python:3.14-slim python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Changing it voids every access token at once; clients get a new one through
# their refresh cookie, so nobody is signed out.
JWT_SECRET=

# Encrypts the provider keys users store in the product. 32 random bytes, base64:
#   docker run --rm python:3.14-slim python -c \
#     "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# Back it up somewhere that is NOT the database backup. Without it, every stored
# key is lost; with it and a stolen dump, every stored key is readable.
SECRETS_KEY=

# Models offered to every user on this instance. Each appears in the models
# screen, masked and marked "from environment", when its variables are set.
# Users can still add their own there; these keys never reach the database.
#
# Anthropic — shows up as "Claude".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI, through the Responses API. Set both or neither.
OPENAI_API_KEY=
OPENAI_MODEL=
# Anything that speaks /v1/chat/completions: Ollama, vLLM, LM Studio,
# OpenRouter... Set the URL and the model, or neither; the key only if it asks
# for one. dialect is "text" (the model writes a code block — what small models
# do best) or "tools" (native tool calling).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_DIALECT=text

# false closes registration — except for the first account, so you can set it
# from the first boot and still create your own.
REGISTRATION_OPEN=true

# Where a browser reaches this instance, without a trailing slash. The OAuth
# redirect URIs are built from it.
PUBLIC_URL=http://localhost:3000

# Sign-in with Google and GitHub. Each button appears only when both of its
# values are set; leave them empty and nobody has to register an OAuth app.
# The redirect URI to register with each provider is
#   <PUBLIC_URL>/api/v1/auth/oauth/google/callback
#   <PUBLIC_URL>/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The kernels. Each conversation gets a container with these limits, on a
# network of its own with no way out.
#
# runc is plain Docker. runsc is gVisor — install it on the host and set it here
# to run generated code under a second kernel; the hosted version always does.
SANDBOX_RUNTIME=runc
KERNEL_MEMORY_MB=2048
KERNEL_CPUS=1.0
# Per execution: past it, the code is interrupted and the kernel's state kept.
EXECUTION_TIMEOUT_SECONDS=300

# The largest file a user can upload, in megabytes.
MAX_UPLOAD_MB=100
